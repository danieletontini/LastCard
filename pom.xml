<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>lastcard</groupId>
  <artifactId>lastcard</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- La classe da avviare con mvn exec:java; si cambia da riga di comando con -Dexec.mainClass=... -->
    <exec.mainClass>lastcard.Main</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Il jar si chiama target/lastcard.jar, senza versione: il comando di avvio resta corto. -->
    <finalName>lastcard</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Avvio: mvn compile exec:java apre la finestra; per il terminale si passa l'argomento della console
           con -Dexec.args (il comando esatto è nel README, un commento XML non può contenere due trattini).
           Anteprima delle carte: mvn -q compile exec:java -Dexec.mainClass=lastcard.view.gui.CardPreview -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.1</version>
      </plugin>
      <!-- mvn package crea un jar che si avvia con java -jar: la classe principale è scritta nel manifest.
           Non ci sono dipendenze da includere, solo le risorse (font, immagini, suoni, regole), che sono già nel jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>lastcard.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
